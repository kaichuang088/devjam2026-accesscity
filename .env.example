# Server-only keys. Do not expose these with a NUXT_PUBLIC_ prefix.
NUXT_GOOGLE_ROUTES_API_KEY=your_google_routes_api_key
# Browser key for the actual Google map. Enable Maps JavaScript API for this key.
NUXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_javascript_api_key
# Used only when the browser location is unavailable.
NUXT_GOOGLE_ROUTES_ORIGIN=台北車站

# Existing Requirement Agent key.
NUXT_GEMINI_API_KEY=your_gemini_api_key
